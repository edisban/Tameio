{
  "realm": "tameio",
  "displayName": "Tameio",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "el",
    "en"
  ],
  "defaultLocale": "el",
  "roles": {
    "realm": [
      {
        "name": "offline_access",
        "description": "${role_offline-access}"
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}"
      },
      {
        "name": "business",
        "description": "Owner or accountant of a business"
      },
      {
        "name": "analyst",
        "description": "Bank credit analyst"
      },
      {
        "name": "manager",
        "description": "Bank credit manager, second approval"
      },
      {
        "name": "admin",
        "description": "Bank administrator"
      },
      {
        "name": "default-roles-tameio",
        "description": "Given to everyone who signs up: they register as a business",
        "composite": true,
        "composites": {
          "realm": [
            "offline_access",
            "uma_authorization",
            "business"
          ],
          "client": {
            "account": [
              "view-profile",
              "manage-account"
            ]
          }
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-tameio"
  },
  "clients": [
    {
      "clientId": "tameio-web",
      "name": "Tameio web app",
      "description": "The React single-page app. Public client: it cannot keep a secret, so it signs in with PKCE.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "rootUrl": "http://localhost:5180",
      "redirectUris": [
        "http://localhost:5180/*"
      ],
      "webOrigins": [
        "http://localhost:5180"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5180/*"
      },
      "protocolMappers": [
        {
          "name": "audience tameio-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "tameio-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "6d1a8f3e-2b4c-4e5f-9a7b-1c2d3e4f5a60",
      "username": "maria",
      "enabled": true,
      "email": "maria@example.com",
      "emailVerified": true,
      "firstName": "Μαρία",
      "lastName": "Δημητρίου",
      "credentials": [
        {
          "type": "password",
          "value": "maria",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-tameio"
      ]
    },
    {
      "id": "7e2b9a4f-3c5d-4f60-8b8c-2d3e4f5a6b71",
      "username": "giorgos",
      "enabled": true,
      "email": "giorgos@kyma-bank.example",
      "emailVerified": true,
      "firstName": "Γιώργος",
      "lastName": "Νικολάου",
      "credentials": [
        {
          "type": "password",
          "value": "giorgos",
          "temporary": false
        }
      ],
      "realmRoles": [
        "analyst"
      ]
    },
    {
      "id": "8f3cab50-4d6e-4071-9c9d-3e4f5a6b7c82",
      "username": "e2e",
      "enabled": true,
      "email": "e2e@example.com",
      "emailVerified": true,
      "firstName": "Αυτόματος",
      "lastName": "Έλεγχος",
      "credentials": [
        {
          "type": "password",
          "value": "e2e",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-tameio"
      ]
    }
  ]
}
