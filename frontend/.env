# Defaults for every mode (dev server, tests, production build), pointing at Keycloak from compose.yaml.
# These are public values: a browser app cannot keep secrets, which is why it signs in as a public
# client with PKCE. A real deployment sets its own values at build time.
VITE_OIDC_AUTHORITY=http://localhost:8180/realms/tameio
VITE_OIDC_CLIENT_ID=tameio-web
