# Editors and OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Local secrets never go into git
.env
.env.local
.env.*.local
# Except the frontend's public defaults: a browser app has no secrets (it signs in with PKCE)
!frontend/.env

# Build output (each app also has its own ignore file)
backend/target/
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
