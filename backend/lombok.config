# This is the project's only Lombok config; do not look for others in parent folders
config.stopBubbling = true
# Mark generated code so coverage tools and static analysis skip it
lombok.addLombokGeneratedAnnotation = true
# Lombok is used only for constructors, getters and loggers; entities must never get equals/hashCode or setters by accident
lombok.data.flagUsage = error
lombok.setter.flagUsage = error
lombok.equalsAndHashCode.flagUsage = error
lombok.log.fieldName = log
